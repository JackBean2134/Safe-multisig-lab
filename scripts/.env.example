# ===== scripts/ 目录 TS 示例专用环境变量（复制为 .env 后填写）=====

# Sepolia RPC
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 发起创建/提案的 owner 私钥（0x 开头）
PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# 创建 Safe 时的 3 个签名者地址（逗号分隔，顺序即 owners 列表）
OWNER_ADDRESSES=0xowner1,0xowner2,0xowner3
# 阈值，固定 2
THRESHOLD=2

# 已创建的 Safe 多签地址（create-safe 跑完后回填）
SAFE_ADDR=0x0000000000000000000000000000000000000000
# 已部署的 Bank/BigBank 地址
BANK_ADDR=0x0000000000000000000000000000000000000000

# encode-calldata.ts 用：ERC20 转账收款人与数量（枚）
RECIPIENT=0x0000000000000000000000000000000000000000
AMOUNT_ETHER=100

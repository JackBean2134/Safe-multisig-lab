# ===== 部署与脚本共用环境变量（复制为 .env 后填写，.env 已在 .gitignore）=====

# 部署者 / 当前 owner 的 EOA 私钥（0x 开头，测试网专用钱包，不要用主网资产）
PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Sepolia RPC（任选其一；见教程附录，公共节点限频时换一个）
# https://ethereum-sepolia-rpc.publicnode.com
# https://eth-sepolia.g.alchemy.com/v2/你的API_KEY
# https://sepolia.infura.io/v3/你的API_KEY
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Etherscan 验证用 API Key（可选，forge --verify 需要；forge 读 ETHERSCAN_API_KEY）
ETHERSCAN_API_KEY=

# --- 部署 Token 时的可选参数 ---
TOKEN_NAME=LabToken
TOKEN_SYMBOL=LAB
# true=部署 BigBank（推荐），false=部署普通 Bank
DEPLOY_BIGBANK=true

# --- TransferOwner / Deposit 脚本使用 ---
BANK_ADDR=0x0000000000000000000000000000000000000000
SAFE_ADDR=0x0000000000000000000000000000000000000000
DEPOSIT_WEI=2000000000000000
